{
  "default_branch": "main",
  "release_branch": "release-{version}",
  "cargo_manifest": "src-tauri/Cargo.toml",
  "cargo_lock": "src-tauri/Cargo.lock",
  "changelog_file": "",
  "metadata_test": "",
  "lock_commands": [
    [
      "npm",
      "install"
    ],
    [
      "npm",
      "run",
      "build"
    ],
    [
      "cargo",
      "check",
      "--manifest-path",
      "src-tauri/Cargo.toml"
    ]
  ],
  "setup_commands": [
    [
      "npm",
      "ci"
    ],
    [
      "npm",
      "run",
      "build"
    ]
  ],
  "check_commands": [
    [
      "npx",
      "tsc",
      "--noEmit"
    ],
    [
      "npm",
      "run",
      "lint"
    ],
    [
      "npm",
      "test"
    ],
    [
      "cargo",
      "fmt",
      "--manifest-path",
      "src-tauri/Cargo.toml",
      "--",
      "--check"
    ],
    [
      "cargo",
      "clippy",
      "--manifest-path",
      "src-tauri/Cargo.toml",
      "--all-targets",
      "--",
      "-D",
      "warnings"
    ],
    [
      "cargo",
      "test",
      "--manifest-path",
      "src-tauri/Cargo.toml"
    ]
  ],
  "build_command": [
    "npx",
    "tauri",
    "build"
  ],
  "windows_assets": [
    "release/bundle/nsis/{product}_{version}_{architecture}-setup.exe",
    "release/bundle/msi/{product}_{version}_{architecture}_en-US.msi"
  ],
  "mac_assets": [
    "{product}_{version}_universal.dmg",
    "{product}_universal.app.tar.gz"
  ],
  "architecture": "x64",
  "unsigned": true,
  "requires_strawberry_perl": false,
  "build_path_limit": 90,
  "replace_windows_assets": false,
  "target_dir": "src-tauri/target"
}
